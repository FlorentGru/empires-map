# Atlas des Empires servi par le Caddy du VPS, sur un port à part (8081) : l'autre projet n'est pas touché.
# Installation : ajouter ce bloc à la fin de /etc/caddy/Caddyfile, puis sudo systemctl reload caddy
:8081 {
	root * /var/www/atlas
	encode gzip
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
