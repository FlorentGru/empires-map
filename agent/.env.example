# Copie ce fichier en agent/.env (jamais committé) et remplis UNE des deux clés (aucune pour Ollama).

# Modèle : un nom Gemini (ex. gemini-flash-latest), « anthropic/<modèle Claude> »
# (ex. anthropic/claude-sonnet-4-5) ou « ollama_chat/<modèle> » (Ollama local, ex. ollama_chat/qwen3:8b).
# Tout nom avec un « / » passe par LiteLLM.
ATLAS_MODEL=gemini-flash-latest

# Ollama : adresse du serveur si ce n'est pas http://localhost:11434
# OLLAMA_API_BASE=http://localhost:11434

# Clé Google AI Studio (https://aistudio.google.com/apikey) pour les modèles Gemini
GOOGLE_API_KEY=

# Clé Anthropic (https://console.anthropic.com/) pour les modèles anthropic/...
ANTHROPIC_API_KEY=
