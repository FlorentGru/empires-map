# Copie ce fichier en agent/.env (jamais committé) et remplis UNE des deux clés.

# Modèle : un nom Gemini (ex. gemini-flash-latest) OU « anthropic/<modèle Claude> »
# (ex. anthropic/claude-sonnet-4-5). Le préfixe anthropic/ active LiteLLM.
ATLAS_MODEL=gemini-flash-latest

# Clé Google AI Studio (https://aistudio.google.com/apikey) pour les modèles Gemini
GOOGLE_API_KEY=

# Clé Anthropic (https://console.anthropic.com/) pour les modèles anthropic/...
ANTHROPIC_API_KEY=
